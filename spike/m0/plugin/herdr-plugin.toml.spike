id = "brainspike"
name = "Brain spike"
version = "0.0.1"
min_herdr_version = "0.9.1"
description = "M0 spike: log plugin context, open a split pane."
platforms = ["macos", "linux"]

[[actions]]
id = "dump"
title = "Brain spike: dump context"
contexts = ["workspace"]
command = ["sh", "dump.sh", "action"]

[[panes]]
id = "review"
title = "Brain spike review"
placement = "split"
command = ["sh", "dump.sh", "pane"]

[[events]]
on = "workspace.renamed"
command = ["sh", "dump.sh", "event"]
