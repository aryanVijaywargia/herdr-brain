{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go test:*)",
      "Read(//tmp/**)"
    ],
    "defaultMode": "default"
  },
  "model": "fake-model",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/test/.claude/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/test/.claude/herdr-agent-state.sh' working"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/test/.claude/herdr-agent-state.sh' idle"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/test/bin/fake-guard --strict"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/test/bin/fake-status"
  }
}
